#!/bin/sh
# The full shellspec suite, before anything leaves the machine. Parallel by
# default because a human is waiting (~40s measured on an M-series laptop);
# CI runs the same suite serially for a legible report.
#
# Enable once per clone: git config core.hooksPath .githooks
# Bypass for one push with git push --no-verify. CI enforces regardless.

# git feeds the refs being pushed on stdin, one per line:
#   <local ref> <local sha> <remote ref> <remote sha>
# A push that only deletes refs or only pushes tags carries nothing the suite
# can newly break, so it goes through without paying for a run.
zero=0000000000000000000000000000000000000000
needs_suite=0
while read -r local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  case "$local_ref" in refs/tags/*) continue ;; esac
  needs_suite=1
done
[ "$needs_suite" -eq 1 ] || exit 0

if ! command -v shellspec >/dev/null 2>&1; then
  printf '\n!! pre-push: shellspec is not installed, so the suite did not run here.\n' >&2
  printf '!! CI enforces it on the pull request. Install locally with:\n!!   brew install shellspec\n\n' >&2
  exit 0
fi

# Default parallel; export SHELLSPEC_JOBS= (empty) to force a serial run.
SHELLSPEC_JOBS="${SHELLSPEC_JOBS-8}"
export SHELLSPEC_JOBS
exec ./scripts/check.sh spec </dev/null
