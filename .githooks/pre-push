#!/bin/sh
# The full shellspec suite, before anything leaves the machine. Parallel by
# default because a human is waiting (roughly a minute, machine-dependent);
# CI runs the same suite serially for a legible report.
#
# Enable once per clone: git config core.hooksPath .githooks
# Bypass for one push with git push --no-verify. CI enforces regardless.

# git feeds the refs being pushed on stdin, one per line:
#   <local ref> <local sha> <remote ref> <remote sha>
# A push that only deletes refs or only pushes tags carries nothing the suite
# can newly break, so it goes through without paying for a run. An all-zero
# local sha is a deletion (40 zeros under SHA-1, 64 under SHA-256, so the
# test is "no non-zero character" rather than a fixed-width constant).
# Reading no ref lines at all is an anomaly, not a skip: the fail-safe
# direction is to run the suite, never to guess it away.
lines=0
needs_suite=0
while read -r local_ref local_sha _remote_ref _remote_sha; do
  lines=$((lines + 1))
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  case "$local_ref" in refs/tags/*) continue ;; esac
  needs_suite=1
done
if [ "$lines" -eq 0 ]; then
  printf 'pre-push: no ref lines on stdin; running the suite rather than guessing\n' >&2
  needs_suite=1
fi
if [ "$needs_suite" -eq 0 ]; then
  printf 'pre-push: only deletions or tags being pushed; skipping the suite (CI runs it regardless)\n' >&2
  exit 0
fi

if ! command -v shellspec >/dev/null 2>&1; then
  printf '\n!! pre-push: shellspec is not installed, so the suite did not run here.\n' >&2
  printf '!! CI enforces it on the pull request. Install locally with:\n!!   brew install shellspec\n\n' >&2
  exit 0
fi

# Default parallel; export SHELLSPEC_JOBS= (empty) to force a serial run.
SHELLSPEC_JOBS="${SHELLSPEC_JOBS-8}"
export SHELLSPEC_JOBS
exec ./scripts/check.sh spec </dev/null
