node_modules/
# Except the hand-authored ones under spec/fixtures: declared_ranges reads a
# parent's installed manifest, so a fixture has to carry one.
!spec/fixtures/*/node_modules/
# And the nested copies inside them, which the single-level negation above does
# not reach. `declared_ranges --line` resolves a parent's own copy of the
# package by node resolution, a nested copy before the hoisted one, so a fixture
# that proves the line filter has to carry both
# ([#76](https://github.com/SurveyMonkey/skills/issues/76)).
!spec/fixtures/*/node_modules/**/node_modules/
.DS_Store
*.log
.env
.env.*

# Generated by spec/js/generate.mjs on every test run: the importable
# projection of the Workflow script, which the coverage gate measures
# (ADR 010). Never edited by hand, never committed.
/spec/js/generated/
# Anchored: unanchored, this would also swallow any `coverage/` directory a
# hand-authored fixture legitimately carries under spec/fixtures/.
/coverage/
